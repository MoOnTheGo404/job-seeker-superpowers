# Copy to .env and fill in. Never commit .env — it is gitignored.

# ---- Supabase ----
# From your Supabase project settings. The publishable (anon) key is safe to
# expose to the browser; row-level security is what protects the data.
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# The VITE_-prefixed copies are what the browser bundle reads. Same values.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---- AI (required) ----
# Powers job-posting parsing and outreach drafting. Google Gemini has a free
# tier and needs no credit card. Create a key at:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.0-flash. Set this to try a different model
# without touching code.
GEMINI_MODEL=

# ---- Search (optional, strongly recommended) ----
# Recruiter discovery quality depends almost entirely on this. Without it the
# app falls back to scraping DuckDuckGo/Mojeek/Bing, which throttle heavily and
# handle `site:` queries poorly — expect few or no LinkedIn profiles.
# https://serper.dev
SERPER_API_KEY=
